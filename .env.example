# MongoDB credentials
MONGO_USER=apostrophe
MONGO_PASSWORD=apostrophe

# Node environment
NODE_ENV=production

# Apostrophe cluster processes (1 for single process)
APOS_CLUSTER_PROCESSES=1

# Apostrophe uploadfs S3 configuration
APOS_S3_BUCKET=
APOS_S3_REGION=
APOS_S3_KEY=
APOS_S3_SECRET=

# Set to 1 in production to publish built frontend assets via uploadfs/S3
APOS_UPLOADFS_ASSETS=
